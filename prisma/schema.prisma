generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileKind {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

model File {
  id           String   @id @default(uuid())
  key          String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  kind         FileKind
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  productGallery  ProductGalleryFile[]
  articleGallery  ArticleGalleryFile[]
  category        Category?
  shippingPartner ShippingPartner?
  banner          Banner?
  brand           Brand?           @relation("BrandLogo")
  homeCarousel    HomeCarousel?    @relation("CarouselLogo")
}

model ProductGalleryFile {
  productId Int
  fileId    String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([productId, fileId])
}

model ArticleGalleryFile {
  articleId Int
  fileId    String
  sortOrder Int     @default(0)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  file      File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([articleId, fileId])
}

model Address {
  id                 String   @id @default(uuid())
  title              String
  latitude           Float
  longitude          Float
  cityId             Int
  userId             String?
  postalCode         BigInt?
  addressDetails     String
  provinceId         Int
  reciverPhoneNumber String
  reciverName        String
  reciverFamilyName  String
  city               City     @relation(fields: [cityId], references: [id])
  Province           Province @relation(fields: [provinceId], references: [id])
  User               User?    @relation(fields: [userId], references: [id])
  Order              Order[]
}

model Province {
  id      Int       @id @default(autoincrement())
  name    String
  engName String
  Address Address[]
  City    City[]
}

model City {
  id         Int       @id @default(autoincrement())
  name       String
  engName    String
  provinceId Int
  Address    Address[]
  Province   Province  @relation(fields: [provinceId], references: [id])
  podroCode  String?
}

model Article {
  id              Int                  @id @default(autoincrement())
  title           String
  englishTitle    String               @default("")
  created_at      DateTime             @default(now())
  updated_at      DateTime?
  comments        Comment[]
  content         String
  metaDescription String?
  isSuggested     Boolean?
  keywords        String[]
  status          ContentStatus        @default(DRAFT)
  galleryFiles    ArticleGalleryFile[]
}

model OrderShipping {
  id                Int              @id @default(autoincrement())
  price             Int
  shippingPartnerId String?
  orderId           Int              @unique
  Order             Order            @relation(fields: [orderId], references: [id])
  ShippingPartner   ShippingPartner? @relation(fields: [shippingPartnerId], references: [id])
  name              String           @default("")
  title             String           @default("")
}

model ShippingPartner {
  id            String          @id @default(uuid())
  name          String
  price         Int             @default(0)
  isActive      Boolean         @default(false)
  sortOrder     Int             @default(0)
  imageFileId   String?         @unique
  imageFile     File?           @relation(fields: [imageFileId], references: [id])
  Order         Order[]
  OrderShipping OrderShipping[]

  @@index([isActive])
}

enum CouponType {
  FREE_SHIPPING
  PERCENT
  FIXED
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  type        CouponType
  value       Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?
  minSubtotal Int?
  usageLimit  Int?
  usedCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  orders      Order[]

  @@index([isActive])
}

model Product {
  id               Int                  @id @default(autoincrement())
  name             String
  price            Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now())
  content          String
  engName          String               @default("")
  discount         Int                  @default(0)
  freeShipping     Boolean              @default(false)
  quantity         Int                  @default(10)
  mainCategoryId   Int                  @default(1)
  metaDescription  String               @default("")
  status           ContentStatus        @default(DRAFT)
  ProductForOrder  ProductForOrder[]
  ProductVariation ProductVariation[]
  category         Category[]           @relation("CategoryToProduct")
  details          String[]
  Comments         Comment[]
  content_keywords String[]
  galleryFiles     ProductGalleryFile[]
  brandId          Int?
  brand            Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  carouselItems    HomeCarouselProduct[]

  @@index([brandId])
}

model ProductVariationValue {
  id                 Int               @id @default(autoincrement())
  name               String
  price              Int
  ProductVariationId Int
  discount           Int               @default(0)
  quantity           Int               @default(10)
  ProductForOrder    ProductForOrder[]
  ProductVariation   ProductVariation  @relation(fields: [ProductVariationId], references: [id])
}

model ProductVariation {
  id              Int                     @id @default(autoincrement())
  variateName     String
  ProductId       Int
  ProductForOrder ProductForOrder[]
  Product         Product                 @relation(fields: [ProductId], references: [id])
  values          ProductVariationValue[]
}

model ProductForOrder {
  id                      Int                    @id @default(autoincrement())
  numberOfproduct         Int
  orderId                 Int?
  productId               Int
  productVariationId      Int?
  productVariationValueId Int?
  Order                   Order?                 @relation(fields: [orderId], references: [id])
  Product                 Product                @relation(fields: [productId], references: [id])
  ProductVariation        ProductVariation?      @relation(fields: [productVariationId], references: [id])
  ProductVariationValue   ProductVariationValue? @relation(fields: [productVariationValueId], references: [id])
}

model Order {
  id                Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now())
  status            OrderStatus
  userId            String
  addressId         String?
  finalPrice        Int?
  shippingPartnerId String?
  Address           Address?          @relation(fields: [addressId], references: [id])
  ShippingPartner   ShippingPartner?  @relation(fields: [shippingPartnerId], references: [id])
  user              User              @relation(fields: [userId], references: [id])
  OrderShipping     OrderShipping?
  Payment           Payment[]
  ProductForOrder   ProductForOrder[]
  podroRequestId    String?
  couponId          Int?
  coupon            Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String?
  couponDiscount    Int               @default(0)

  @@index([couponId])
}

model Category {
  id               Int            @id @default(autoincrement())
  title            String
  parentCategoryId Int?
  imageFileId      String?        @unique
  imageFile        File?          @relation(fields: [imageFileId], references: [id])
  content          String         @default("")
  englishTitle     String         @default("")
  parentCategory   Category?      @relation("SubCategories", fields: [parentCategoryId], references: [id])
  subCategories    Category[]     @relation("SubCategories")
  products         Product[]      @relation("CategoryToProduct")
  updated_at       DateTime?      @default(now())
  metaDescription  String         @default("")
  status           CategoryStatus @default(ENABLED)
  carousels        HomeCarousel[]
}

enum CategoryStatus {
  ENABLED
  DISABLED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BannerPlacement {
  HERO
  SIDE
}

model Brand {
  id              Int       @id @default(autoincrement())
  name            String
  englishName     String    @default("")
  content         String    @default("")
  metaDescription String    @default("")
  isActive        Boolean   @default(true)
  logoFileId      String?   @unique
  logoFile        File?     @relation("BrandLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
  carousels       HomeCarousel[]

  @@index([isActive])
}

enum HomeCarouselSource {
  CATEGORY
  BRAND
  MANUAL
}

model HomeCarousel {
  id         Int                   @id @default(autoincrement())
  slot       String                @unique
  title      String
  logoFileId String?               @unique
  logoFile   File?                 @relation("CarouselLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  source     HomeCarouselSource
  categoryId Int?
  category   Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId    Int?
  brand      Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  products   HomeCarouselProduct[]

  @@index([isActive])
  @@index([categoryId])
  @@index([brandId])
}

model HomeCarouselProduct {
  carouselId Int
  productId  Int
  sortOrder  Int          @default(0)
  carousel   HomeCarousel @relation(fields: [carouselId], references: [id], onDelete: Cascade)
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([carouselId, productId])
  @@index([productId])
}

model Banner {
  id          String          @id @default(uuid())
  placement   BannerPlacement
  title       String?
  href        String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  imageFileId String          @unique
  imageFile   File            @relation(fields: [imageFileId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model User {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(20)
  familyName     String?
  password       String?
  email          String?   @unique
  phoneNumber    String    @unique
  role           role      @default(USER)
  loginCode      String?
  isVerified     Boolean   @default(false)
  credit         Int       @default(0)
  createdAt      DateTime  @default(now())
  lastLogin      DateTime?
  numberOfLogins Int?      @default(1)
  Addresses      Address[]
  order          Order[]
  Payment        Payment[]
  Session        Session[]
  Comment        Comment[] @relation("user_and_comment")
  Comment_Likes  Comment[] @relation("likes")
}

model Session {
  id         String   @id @default(uuid())
  expireDate DateTime @default(now())
  userId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Payment {
  id                   Int       @id @default(autoincrement())
  payment_create_date  DateTime  @default(now())
  payment_success_date DateTime?
  userId               String
  trackId              String    @unique
  status               Int?
  isPayed              Boolean   @default(false)
  servicePaymentId     String?   @unique
  paymentUrl           String?
  value                Int
  cardNumber           String?
  paymentDescription   String?
  orderId              Int
  Order                Order     @relation(fields: [orderId], references: [id])
  user                 User      @relation(fields: [userId], references: [id])
}

model Comment {
  id                Int            @id @default(autoincrement())
  User              User           @relation("user_and_comment", fields: [userId], references: [id])
  userId            String
  Product           Product?       @relation(fields: [productId], references: [id])
  productId         Int?
  content           String
  child_comments    Comment[]      @relation("child_comments")
  parent_comment    Comment?       @relation("child_comments", fields: [parent_comment_id], references: [id])
  parent_comment_id Int?
  status            Comment_Status @default(NEED_REVIEW)
  likes             User[]         @relation("likes")
  Article           Article?       @relation(fields: [articleId], references: [id])
  articleId         Int?
}

enum Comment_Status {
  APPROVED
  NEED_REVIEW
  FAILED
  NOT_SHOWN
}

enum role {
  USER
  ADMIN
}

enum OrderStatus {
  ACTIVE
  PAYED
  DELIVERED
  DELIVERING
}
