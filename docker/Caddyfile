{
	email {$CADDY_EMAIL}
}

{$CADDY_SITE_HOST} {
	encode gzip zstd
	reverse_proxy app:3000 {
		# Stream App Router responses instead of buffering them until the end.
		flush_interval -1
	}
}

{$CADDY_FILES_HOST} {
	encode gzip zstd
	reverse_proxy minio:9000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
