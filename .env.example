INITIAL_CREDIT=10000
JWT_PRIVATE_KEY=
BASE_URL=http://localhost:3000

# Seeded admin (phone = username). Run: yarn db:seed
ADMIN_PHONE=
ADMIN_PASSWORD=
# Shared password for seeded customer accounts (optional)
SEED_USER_PASSWORD=Merseh1234

# Postgres (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=merseh
POSTGRES_DB=mehrnil
POSTGRES_PORT=5435
DATABASE_URL=postgresql://postgres:merseh@127.0.0.1:5435/mehrnil
DATABASE_URL_LOCAL=postgresql://postgres:merseh@127.0.0.1:5435/mehrnil

# MinIO object storage
MINIO_ENDPOINT=http://127.0.0.1:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mehrnil
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Public URL clients use to load objects (path-style: {endpoint}/{bucket})
NEXT_PUBLIC_FILES_ENDPOINT=http://127.0.0.1:9010/mehrnil

NEXT_PUBLIC_MAPBOX_SECRET_TOKEN=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=
ZIBAL_MERCHANT_CODE=
POSTEX_USERNAME=
POSTEX_PASSWORD=
MIARE_TOKEN=
STORE_LATITUDE=
STORE_LONGITUDE=
PODRO_TOKEN=
NODE_OPTIONS=--dns-result-order=ipv4first

# Production (Ubuntu). Copy this file to .env on the server, then:
#   bash scripts/deploy.sh
# BASE_URL and NEXT_PUBLIC_FILES_ENDPOINT must be public https URLs. They are
# baked into the client bundle at image build time. Example:
#   BASE_URL=https://mehrnil.com
#   NEXT_PUBLIC_FILES_ENDPOINT=https://static.mehrnil.ir/mehrnil
# Point DNS for both hosts at this server. Caddy serves them on ports 80 and 443.
# CADDY_EMAIL=ops@example.com
# Optional when the certificate names differ from those URLs:
#   CADDY_SITE_HOST=mehrnil.com, www.mehrnil.com
#   CADDY_FILES_HOST=static.mehrnil.ir
# The app container overrides DATABASE_URL (postgres:5432) and MINIO_ENDPOINT
# (http://minio:9000). MINIO_ACCESS_KEY / MINIO_SECRET_KEY must match the root user.
# App and MinIO stay on localhost: APP_PORT=3000, MINIO_PORT=9010, MINIO_CONSOLE_PORT=9011
# APP_MEMORY_LIMIT=1536m
# Backups land in ./backups daily at 03:00. BACKUP_RETAIN_DAYS=14  BACKUP_TZ=Asia/Tehran
